APP_NAME="Syntax Technology"
APP_ENV=local
APP_KEY=
# Security audit finding C1: defaults to false. A debug-mode stack trace
# (file paths, exception messages, framework internals) is never sent to
# an API client regardless of this value (see bootstrap/app.php's
# catch-all exception handler) — but set this to true only for local
# development, never in production, since debug mode still affects other
# surfaces (e.g. verbose logging, config caching behavior).
APP_DEBUG=false
APP_URL=http://localhost

# Same-origin SPA served from APP_URL authenticates via Sanctum cookies
# (architecture §8). Port 3000 is this repo's frontend dev server default
# (see /server.ts and the root .env's PORT); 5173 covers running plain
# `vite` directly. Add any other port you actually serve the frontend on.
SANCTUM_STATEFUL_DOMAINS=localhost:8000,localhost:3000,localhost:5173,127.0.0.1:8000,127.0.0.1:3000,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Security audit finding H4: comma-separated list of IPs/CIDRs for any
# reverse proxy, load balancer, or CDN this app is deployed behind (e.g.
# your load balancer's private subnet). Leave empty for a direct
# deployment with no proxy in front — the default, and the safe choice
# unless you specifically have one. Every rate limiter in this app
# (login, public-write, public-read) keys on the visitor's IP; without
# this set correctly for your actual topology, a reverse proxy makes
# every visitor look like the same IP (collapsing all those limits into
# one shared bucket), while trusting one you don't actually have in front
# of you lets any client spoof its own apparent IP via X-Forwarded-For.
TRUSTED_PROXIES=

# First admin account, created by `php artisan db:seed`. Security audit
# finding C2: there is no safe default here — the seeder refuses to run
# (raises an error) unless this is a real, unique password of at least 12
# characters that isn't one of this project's own previously-shipped
# placeholder values. Change it again immediately after first login as an
# extra precaution.
ADMIN_NAME="Syntax Admin"
ADMIN_EMAIL=admin@syntaxtech.local
ADMIN_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=syntax_et
DB_USERNAME=syntax_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Security audit finding M1: forces the session/XSRF-TOKEN cookies to only
# ever be sent over HTTPS. Set to false only for local HTTP-only
# development (this repo's dev setup uses plain http://localhost).
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
