# ---------------------------------------------------------------------------
# Syntax Technology — environment configuration
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored;
# never commit real credentials.
# ---------------------------------------------------------------------------

# Google Gemini API key. Required by the /api/assistant endpoint that powers
# the "Syntax AI Advisor". Without it the endpoint returns a 500 and the UI
# falls back to the consultation/quotation forms.
GEMINI_API_KEY=""

# Public URL the app is served from. Used for self-referential links and
# callbacks. Defaults to http://localhost:3000 in development.
APP_URL="http://localhost:3000"

# HTTP port and bind address for the Express server. Optional.
PORT="3000"
HOST="0.0.0.0"

# Set to "true" to disable Vite HMR and file watching in the dev server.
# Useful on low-CPU containers or during automated editing sessions. Optional.
DISABLE_HMR="false"

# Base URL of the Laravel backend (see /backend). Services, projects,
# courses, leads, course registrations, support requests, and the admin
# panel all call this API directly — it is a different origin from this
# app in development, which is why the backend's CORS/Sanctum config
# explicitly allows it. Read at build time by Vite, so it must be prefixed
# VITE_ and the dev server restarted after changing it.
VITE_API_BASE_URL="http://localhost:8000"
